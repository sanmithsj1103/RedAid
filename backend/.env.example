# ============================================================
# RedAid Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit the .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ----------------------------------------------------------
# Redis (Upstash — Free Tier)
# ----------------------------------------------------------
# Get these from: Upstash Console → Redis → Database Details
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# ----------------------------------------------------------
# Firebase (Cloud Messaging)
# ----------------------------------------------------------
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------
# Resend (Transactional Email)
# ----------------------------------------------------------
# Get this from: Resend Dashboard → API Keys
RESEND_API_KEY=re_your-api-key-here

# ----------------------------------------------------------
# Sentry (Error Tracking)
# ----------------------------------------------------------
# Get this from: Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your-sentry-dsn@o000000.ingest.sentry.io/0000000

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
